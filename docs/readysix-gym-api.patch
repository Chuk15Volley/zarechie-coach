diff --git a/lib/programGeneratorCalendar.mjs b/lib/programGeneratorCalendar.mjs
new file mode 100644
index 0000000..f2aa7ad
--- /dev/null
+++ b/lib/programGeneratorCalendar.mjs
@@ -0,0 +1,47 @@
+import { normalizeSessionSchedule, sessionScheduleKey } from './sessionSchedule.mjs';
+import { resolveReadySixReportsConfig } from './reportsConfig.mjs';
+
+const shift = (date, days) => {
+  const value = new Date(`${date}T12:00:00Z`);
+  value.setUTCDate(value.getUTCDate() + days);
+  return value.toISOString().slice(0, 10);
+};
+const parse = raw => {
+  try { return typeof raw === 'string' ? JSON.parse(raw) : raw; } catch { return null; }
+};
+
+// The supplied redis is already bound to the credential's organization/region.
+// No client-provided organization or separate club calendar is consulted.
+export async function readProgramGeneratorCalendar(redis, date, organizationId) {
+  const dates = Array.from({ length: 43 }, (_, index) => shift(date, index - 14));
+  const values = await redis('MGET', 'reports:config:v1', ...dates.map(sessionScheduleKey));
+  const config = resolveReadySixReportsConfig(parse(values?.[0]) || {}, { organizationId });
+  const events = new Map(Object.entries(config.events || {})
+    .filter(([day]) => day >= dates[0] && day <= shift(date, 90))
+    .map(([day, event]) => [day, { date: day, type: event.type, label: event.label, opponent: event.opponent, source: 'reports', confirmed: true }]));
+  const conflicts = [];
+  let today = null;
+  dates.forEach((day, index) => {
+    const raw = parse(values?.[index + 1]);
+    if (!raw || (raw.organizationId && raw.organizationId !== organizationId)) return;
+    const schedule = normalizeSessionSchedule(raw, day);
+    if (day === date) today = {
+      date: day, confirmed: schedule.confirmed, planType: schedule.planType,
+      dayType: schedule.dayType, morning: {
+        enabled: schedule.morning.enabled, gymIncluded: schedule.morning.gymIncluded,
+        strengthFocus: schedule.morning.strengthFocus,
+      }, evening: { enabled: schedule.evening.enabled, direction: schedule.evening.direction },
+    };
+    if (!schedule.confirmed) return;
+    const existing = events.get(day);
+    const normalizedType = type => ['gym_only', 'gym_volleyball', 'volleyball_only', 'pregame'].includes(type) ? 'training' : type === 'flight' ? 'travel' : type;
+    if (existing && normalizedType(existing.type) !== normalizedType(schedule.dayType)) {
+      conflicts.push({ date: day, reportType: existing.type, scheduleType: schedule.dayType });
+      // Preserve a declared match even when the day plan contradicts it.
+      if (existing.type === 'match') return;
+    }
+    events.set(day, { ...existing, date: day, type: schedule.dayType, planType: schedule.planType, source: 'confirmed_schedule', confirmed: true });
+  });
+  return { source: 'ReadySix', date, windowStart: dates[0], windowEnd: shift(date, 90), today,
+    events: [...events.values()].sort((a, b) => a.date.localeCompare(b.date)), conflicts };
+}
diff --git a/tests/unit/program-generator-calendar.test.mjs b/tests/unit/program-generator-calendar.test.mjs
new file mode 100644
index 0000000..df291b0
--- /dev/null
+++ b/tests/unit/program-generator-calendar.test.mjs
@@ -0,0 +1,33 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readProgramGeneratorCalendar } from '../../lib/programGeneratorCalendar.mjs';
+const date = '2026-09-16';
+const org = 'zarechie-odintsovo';
+const store = records => async (command, ...keys) => {
+  assert.equal(command, 'MGET');
+  return keys.map(key => records[key] ? JSON.stringify(records[key]) : null);
+};
+test('exports real matches and confirmed plans separately from health', async () => {
+  const result = await readProgramGeneratorCalendar(store({
+    'reports:config:v1': { events: { '2026-09-20': { type: 'match', opponent: 'Opponent' } } },
+    [`session:schedule:${date}`]: { organizationId: org, confirmed: true, planType: 'rest' },
+  }), date, org);
+  assert.equal(result.today.planType, 'rest');
+  assert.equal(result.events.find(event => event.date === '2026-09-20').type, 'match');
+  assert.equal(result.events.find(event => event.date === date).type, 'rest');
+});
+test('missing data does not invent events and foreign schedules are ignored', async () => {
+  const result = await readProgramGeneratorCalendar(store({
+    [`session:schedule:${date}`]: { organizationId: 'another-org', confirmed: true, planType: 'match' },
+  }), date, org);
+  assert.equal(result.today, null);
+  assert.deepEqual(result.events, []);
+});
+test('conflicting confirmed rest cannot erase a match', async () => {
+  const result = await readProgramGeneratorCalendar(store({
+    'reports:config:v1': { events: { [date]: { type: 'match' } } },
+    [`session:schedule:${date}`]: { organizationId: org, confirmed: true, planType: 'rest' },
+  }), date, org);
+  assert.equal(result.events[0].type, 'match');
+  assert.equal(result.conflicts.length, 1);
+});
